def normalize_location_string(loc_str):
    """Cleans and standardizes location string for lookup."""
    if not loc_str:
        return ""
    text = loc_str.lower().strip()
    text = re.sub(r'[\r\n\t]+', ' ', text)
    text = re.sub(r'[^\w\s,]', '', text)
    return re.sub(r'\s+', ' ', text)


def resolve_location(location_text=None, latitude=None, longitude=None, enable_online=False):
    """
    Resolves location to latitude and longitude.

    Args:
        location_text (str): Free-form user location input (e.g. "Sector 21, Sonipat").
        latitude (float, optional): User or GPS-provided latitude.
        longitude (float, optional): User or GPS-provided longitude.
        enable_online (bool, optional): Whether to attempt online Nominatim fallback.

    Returns:
        dict: {
            "location_text": str,
            "latitude": float or None,
            "longitude": float or None,
            "source": str,
            "resolved": bool
        }
    """
    # 1. If explicit valid coordinates were provided, use them directly
    if latitude is not None and longitude is not None:
        try:
            lat = float(latitude)
            lon = float(longitude)
            if -90.0 <= lat <= 90.0 and -180.0 <= lon <= 180.0:
                return {
                    "location_text": location_text or f"{lat:.4f}, {lon:.4f}",
                    "latitude": lat,
                    "longitude": lon,
                    "source": "provided_coordinates",
                    "resolved": True
                }
        except (ValueError, TypeError):
            pass

    if not location_text or not isinstance(location_text, str):
        return {
            "location_text": "",
            "latitude": None,
            "longitude": None,
            "source": "unresolved_missing",
            "resolved": False
        }

    norm = normalize_location_string(location_text)

    # 2. Exact match in regional offline registry
    if norm in OFFLINE_LOCATIONS:
        lat, lon = OFFLINE_LOCATIONS[norm]
        return {
            "location_text": location_text,
            "latitude": lat,
            "longitude": lon,
            "source": "local_registry_exact",
            "resolved": True
        }

    # Clean version without commas
    no_comma = norm.replace(",", " ")
    no_comma = re.sub(r'\s+', ' ', no_comma).strip()
    if no_comma in OFFLINE_LOCATIONS:
        lat, lon = OFFLINE_LOCATIONS[no_comma]
        return {
            "location_text": location_text,
            "latitude": lat,
            "longitude": lon,
            "source": "local_registry_exact",
            "resolved": True
        }

    # 3. Substring / keyword match in regional offline registry
    # Check for specific sectors first, then city names
    for key, coords in OFFLINE_LOCATIONS.items():
        if key in norm or key in no_comma:
            return {
                "location_text": location_text,
                "latitude": coords[0],
                "longitude": coords[1],
                "source": "local_registry_keyword",
                "resolved": True
            }

    # 4. Optional online OpenStreetMap fallback (disabled by default for speed & reliability)
    if enable_online:
        try:
            url = f"https://nominatim.openstreetmap.org/search?q={urllib.parse.quote(location_text)}&format=json&limit=1"
            req = urllib.request.Request(url, headers={"User-Agent": "NirmaanCivicMatcher/1.0"})
            with urllib.request.urlopen(req, timeout=1.5) as resp:
                data = json.loads(resp.read().decode())
                if data and len(data) > 0:
                    lat = float(data[0]["lat"])
                    lon = float(data[0]["lon"])
                    return {
                        "location_text": location_text,
                        "latitude": lat,
                        "longitude": lon,
                        "source": "nominatim_online",
                        "resolved": True
                    }
        except Exception:
            pass

    # 5. Unresolved fallback
    return {
        "location_text": location_text,
        "latitude": None,
        "longitude": None,
        "source": "unresolved",
        "resolved": False
    }
